#include <stdint.h>
#include <stdbool.h>
#include <string.h>
#include <avr/io.h>
#include <avr/interrupt.h>
#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ILI9341.h>

/* ===================== 1. HARDWARE PIN DEFINITIONS ===================== */
// ILI9341 TFT SPI Control Pins (Hardware SPI: MOSI=51, MISO=50, SCK=52)
#define TFT_CS_PIN          53
#define TFT_DC_PIN          49
#define TFT_RST_PIN         48

// 4x4 Matrix Keypad Pins (Rows = Outputs, Columns = Internal Pull-up Inputs)
const uint8_t KEYPAD_ROW_PINS[4] = {22, 24, 26, 28};
const uint8_t KEYPAD_COL_PINS[4] = {30, 32, 34, 36};

// Five External Tactile Push Buttons (Active-LOW with Internal Pull-ups)
#define NUM_BUTTONS         5
const uint8_t BTN_PINS[NUM_BUTTONS] = {2, 3, 4, 5, 6}; // D2-D5: Cand 1-4, D6: Confirm

// Four Status LEDs (Active-HIGH through 200 Ohm current-limiting resistors)
#define LED_RED_PIN         8   // Error / Invalid Input
#define LED_BLUE_PIN        9   // Ready (Solid) / Awaiting Confirmation (Blink)
#define LED_GREEN_PIN       10  // Vote Confirmed & Recorded
#define LED_YELLOW_PIN      11  // Booting / Admin Results Mode

/* ===================== 2. SYSTEM CONSTANTS & TYPES ===================== */
#define NUM_CANDIDATES      4
#define DEBOUNCE_TICKS      3       // 3 x 10 ms ISR ticks = 30 ms debounce filter
#define VOTE_FEEDBACK_MS    2000    // Green LED confirmation duration (ms)
#define ERROR_FEEDBACK_MS   1200    // Red LED invalid input alert duration (ms)
#define ADMIN_PIN_CODE      "1234"  // 4-digit presiding officer PIN

typedef enum {
    STATE_INIT = 0,
    STATE_READY,
    STATE_CAND_SELECTED,
    STATE_VOTE_COMMITTED,
    STATE_ADMIN_PIN_ENTRY,
    STATE_ADMIN_RESULTS,
    STATE_ERROR
} EvmState_t;

const char KEYMAP[4][4] = {
    {'1', '2', '3', 'A'},
    {'4', '5', '6', 'B'},
    {'7', '8', '9', 'C'},
    {'*', '0', '#', 'D'}
};

const char* CANDIDATE_NAMES[NUM_CANDIDATES] = {
    "1. Candidate A (Alpha)",
    "2. Candidate B (Beta)",
    "3. Candidate C (Gamma)",
    "4. Candidate D (Delta)"
};

/* ===================== 3. VOLATILE ISR & GLOBAL STATE ================== */
volatile uint32_t g_sysMillis                  = 0;               // System uptime counter incremented in ISR
volatile uint8_t  g_btnIntegrator[NUM_BUTTONS] = {0};
volatile uint8_t  g_btnStableState[NUM_BUTTONS]= {1, 1, 1, 1, 1}; // 1 = Released
volatile uint8_t  g_btnPressedFlag[NUM_BUTTONS]= {0};             // Edge-triggered event flags
volatile bool     g_blinkPhase                 = false;           // 2 Hz toggle flag for Blue LED

Adafruit_ILI9341 tft = Adafruit_ILI9341(TFT_CS_PIN, TFT_DC_PIN, TFT_RST_PIN);

EvmState_t g_currentState               = STATE_INIT;
bool       g_uiDirty                    = true;          // Triggers TFT redraw only on state change
uint8_t    g_selectedCand               = 0;             // Active candidate index (1..4)
uint32_t   g_voteCounts[NUM_CANDIDATES] = {0, 0, 0, 0};
uint32_t   g_stateTimerStart            = 0;
char       g_pinBuffer[5]               = {0};
uint8_t    g_pinLen                     = 0;

/* ===================== 4. TIMER1 INTERRUPT SERVICE ROUTINE ============= */
/**
 * @brief Configures ATmega2560 Timer1 in CTC mode for a 10.0 ms (100 Hz) interrupt.
 *        Formula: OCR1A = (16,000,000 / (64 * 100)) - 1 = 2499.
 */
void Timer1_Init_10ms(void) {
    cli();                               // Disable global interrupts during setup
    TCCR1A = 0;                          // Normal port operation, WGM11:10 = 0
    TCCR1B = 0;
    TCNT1  = 0;                          // Reset counter register
    OCR1A  = 2499;                       // Compare match value for 10 ms at 16 MHz / 64
    TCCR1B |= (1 << WGM12);              // Enable CTC mode (Clear Timer on Compare)
    TCCR1B |= (1 << CS11) | (1 << CS10); // Set prescaler to 64
    TIMSK1 |= (1 << OCIE1A);             // Enable Timer1 Compare Match A interrupt
    sei();                               // Re-enable global interrupts
}

/**
 * @brief Periodic 10 ms ISR: updates uptime clock, debounces 5 tactile buttons
 *        using vertical counter integration, and toggles LED blink phase.
 */
ISR(TIMER1_COMPA_vect) {
    static uint8_t blinkCounter = 0;
    g_sysMillis += 10;

    // Generate 250 ms half-period (2 Hz) blink clock for pending vote confirmation
    if (++blinkCounter >= 25) {
        blinkCounter = 0;
        g_blinkPhase = !g_blinkPhase;
    }

    // Debounce all 5 external push buttons (Active-LOW logic)
    for (uint8_t i = 0; i < NUM_BUTTONS; i++) {
        uint8_t rawSample = digitalRead(BTN_PINS[i]); // 0 = Pressed, 1 = Released
        if (rawSample == 0) {
            if (g_btnIntegrator[i] < DEBOUNCE_TICKS) {
                g_btnIntegrator[i]++;
            } else if (g_btnStableState[i] == 1) {
                g_btnStableState[i] = 0;      // Transition confirmed: Released -> Pressed
                g_btnPressedFlag[i] = 1;      // Latch single press event for main loop
            }
        } else {
            g_btnIntegrator[i]  = 0;
            g_btnStableState[i] = 1;          // Button released; ready for next press
        }
    }
}

/* ===================== 5. KEYPAD SCANNING & TELEMETRY ================== */
/**
 * @brief Scans the 4x4 matrix keypad with 30 ms software debounce & release lock.
 * @return ASCII character of newly pressed key, or '\0' if none.
 */
char Keypad_GetKey(void) {
    static char     lastRawKey   = '\0';
    static char     reportedKey  = '\0';
    static uint32_t lastChangeMs = 0;
    char detected = '\0';

    for (uint8_t r = 0; r < 4; r++) {
        digitalWrite(KEYPAD_ROW_PINS[r], LOW);
        delayMicroseconds(5); // Allow line capacitance to settle
        for (uint8_t c = 0; c < 4; c++) {
            if (digitalRead(KEYPAD_COL_PINS[c]) == LOW) {
                detected = KEYMAP[r][c];
            }
        }
        digitalWrite(KEYPAD_ROW_PINS[r], HIGH);
    }

    if (detected != lastRawKey) {
        lastRawKey   = detected;
        lastChangeMs = g_sysMillis;
    }

    if ((g_sysMillis - lastChangeMs) >= 30) {
        if (detected != reportedKey) {
            reportedKey = detected;
            if (reportedKey != '\0') {
                return reportedKey; // Return single edge-triggered key event
            }
        }
    }
    return '\0';
}

void UART_Log(const char* tag, const char* msg) {
    Serial.print("[");
    Serial.print(g_sysMillis);
    Serial.print(" ms][");
    Serial.print(tag);
    Serial.print("] ");
    Serial.println(msg);
}

/* ===================== 6. LED & TFT DISPLAY MANAGEMENT ================= */
void LED_UpdateOutputs(void) {
    digitalWrite(LED_RED_PIN,    (g_currentState == STATE_ERROR) ? HIGH : LOW);
    digitalWrite(LED_GREEN_PIN,  (g_currentState == STATE_VOTE_COMMITTED) ? HIGH : LOW);
    digitalWrite(LED_YELLOW_PIN, (g_currentState == STATE_INIT ||
                                  g_currentState == STATE_ADMIN_PIN_ENTRY ||
                                  g_currentState == STATE_ADMIN_RESULTS) ? HIGH : LOW);

    if (g_currentState == STATE_READY) {
        digitalWrite(LED_BLUE_PIN, HIGH);
    } else if (g_currentState == STATE_CAND_SELECTED) {
        digitalWrite(LED_BLUE_PIN, g_blinkPhase ? HIGH : LOW);
    } else {
        digitalWrite(LED_BLUE_PIN, LOW);
    }
}

void UI_RenderScreen(void) {
    if (!g_uiDirty) return;
    g_uiDirty = false;

    tft.fillScreen(ILI9341_BLACK);
    tft.setTextWrap(false);

    // Top Header Banner
    tft.fillRect(0, 0, 320, 36, ILI9341_NAVY);
    tft.setTextColor(ILI9341_CYAN);
    tft.setTextSize(2);
    tft.setCursor(14, 10);
    tft.print("ELECTRONIC VOTING MACHINE");

    switch (g_currentState) {
        case STATE_READY:
            tft.setTextColor(ILI9341_GREEN);
            tft.setCursor(14, 48);
            tft.print("STATUS: READY TO VOTE");
            tft.setTextColor(ILI9341_WHITE);
            tft.setTextSize(2);
            for (uint8_t i = 0; i < NUM_CANDIDATES; i++) {
                tft.setCursor(18, 82 + (i * 28));
                tft.print(CANDIDATE_NAMES[i]);
            }
            tft.setTextColor(ILI9341_YELLOW);
            tft.setTextSize(1);
            tft.setCursor(14, 212);
            tft.print("Press Key [1-4] or BTN [1-4] | Admin: [*]");
            break;

        case STATE_CAND_SELECTED:
            tft.setTextColor(ILI9341_YELLOW);
            tft.setCursor(14, 52);
            tft.print("VERIFY SELECTION:");
            tft.fillRoundRect(14, 82, 292, 44, 6, ILI9341_DARKGREEN);
            tft.setTextColor(ILI9341_WHITE);
            tft.setCursor(24, 96);
            tft.print(CANDIDATE_NAMES[g_selectedCand - 1]);
            tft.setTextColor(ILI9341_CYAN);
            tft.setCursor(14, 150);
            tft.print("Press [#] / BTN5: CONFIRM");
            tft.setTextColor(ILI9341_RED);
            tft.setCursor(14, 180);
            tft.print("Press [C]: CANCEL");
            break;

        case STATE_VOTE_COMMITTED:
            tft.fillRoundRect(20, 70, 280, 100, 8, ILI9341_DARKGREEN);
            tft.setTextColor(ILI9341_WHITE);
            tft.setTextSize(2);
            tft.setCursor(46, 95);
            tft.print("VOTE RECORDED!");
            tft.setTextSize(1);
            tft.setCursor(54, 132);
            tft.print("Thank you. Returning to READY...");
            break;

        case STATE_ADMIN_PIN_ENTRY:
            tft.setTextColor(ILI9341_YELLOW);
            tft.setCursor(14, 60);
            tft.print("ADMIN AUTHENTICATION");
            tft.setTextColor(ILI9341_WHITE);
            tft.setCursor(14, 100);
            tft.print("Enter 4-Digit PIN: ");
            for (uint8_t i = 0; i < g_pinLen; i++) tft.print("*");
            tft.setTextSize(1);
            tft.setCursor(14, 190);
            tft.print("Press [D] to Abort");
            break;

        case STATE_ADMIN_RESULTS:
            tft.setTextColor(ILI9341_CYAN);
            tft.setCursor(14, 46);
            tft.print("OFFICIAL VOTE TALLY:");
            tft.setTextColor(ILI9341_WHITE);
            for (uint8_t i = 0; i < NUM_CANDIDATES; i++) {
                tft.setCursor(18, 78 + (i * 26));
                tft.print("Cand ");
                tft.print(i + 1);
                tft.print(": ");
                tft.print(g_voteCounts[i]);
                tft.print(" votes");
            }
            tft.setTextColor(ILI9341_ORANGE);
            tft.setTextSize(1);
            tft.setCursor(14, 205);
            tft.print("[#]: Reset Counts  |  [D]: Exit to Voting");
            break;

        case STATE_ERROR:
            tft.fillRoundRect(20, 75, 280, 90, 8, ILI9341_MAROON);
            tft.setTextColor(ILI9341_WHITE);
            tft.setCursor(55, 102);
            tft.print("INVALID ACTION!");
            tft.setTextSize(1);
            tft.setCursor(52, 135);
            tft.print("Please follow on-screen prompts.");
            break;

        default:
            break;
    }
}

/* ===================== 7. FINITE-STATE MACHINE CONTROLLER ============== */
void TransitionTo(EvmState_t nextState, const char* reason) {
    g_currentState    = nextState;
    g_stateTimerStart = g_sysMillis;
    g_uiDirty         = true;
    UART_Log("FSM", reason);
}

void setup(void) {
    Serial.begin(9600);
    UART_Log("BOOT", "Initializing Arduino Mega 2560 EVM Firmware v1.0...");

    // Configure LED outputs
    pinMode(LED_RED_PIN, OUTPUT);
    pinMode(LED_BLUE_PIN, OUTPUT);
    pinMode(LED_GREEN_PIN, OUTPUT);
    pinMode(LED_YELLOW_PIN, OUTPUT);
    LED_UpdateOutputs();

    // Configure 4x4 Keypad GPIO
    for (uint8_t i = 0; i < 4; i++) {
        pinMode(KEYPAD_ROW_PINS[i], OUTPUT);
        digitalWrite(KEYPAD_ROW_PINS[i], HIGH);
        pinMode(KEYPAD_COL_PINS[i], INPUT_PULLUP);
    }

    // Configure 5 External Push Buttons with Internal Pull-ups
    for (uint8_t i = 0; i < NUM_BUTTONS; i++) {
        pinMode(BTN_PINS[i], INPUT_PULLUP);
    }

    // Initialize ILI9341 TFT Display
    tft.begin();
    tft.setRotation(1); // Landscape 320x240

    // Start 100 Hz Timer1 Interrupt
    Timer1_Init_10ms();

    TransitionTo(STATE_READY, "Initialization complete -> STATE_READY");
}

void loop(void) {
    // 1. Acquire debounced inputs from Keypad and Timer1 ISR Button Flags
    char key = Keypad_GetKey();
    int8_t btnEvent = -1;

    cli();
    for (uint8_t i = 0; i < NUM_BUTTONS; i++) {
        if (g_btnPressedFlag[i]) {
            g_btnPressedFlag[i] = 0;
            btnEvent = i; // 0..3 = Candidate 1..4, 4 = Confirm
            break;
        }
    }
    sei();

    // 2. Execute State Machine Logic
    switch (g_currentState) {
        case STATE_READY:
            if (key >= '1' && key <= '4') {
                g_selectedCand = key - '0';
                TransitionTo(STATE_CAND_SELECTED, "Candidate selected via Keypad");
            } else if (btnEvent >= 0 && btnEvent <= 3) {
                g_selectedCand = btnEvent + 1;
                TransitionTo(STATE_CAND_SELECTED, "Candidate selected via Push Button");
            } else if (key == '*') {
                g_pinLen = 0;
                memset(g_pinBuffer, 0, sizeof(g_pinBuffer));
                TransitionTo(STATE_ADMIN_PIN_ENTRY, "Admin PIN entry requested");
            } else if (key != '\0' || btnEvent == 4) {
                TransitionTo(STATE_ERROR, "Invalid key/button pressed in READY state");
            }
            break;

        case STATE_CAND_SELECTED:
            if (key == '#' || btnEvent == 4) {
                // FR-06: Increment ONLY the selected candidate counter by exactly 1
                g_voteCounts[g_selectedCand - 1]++;
                Serial.print("[AUDIT] Vote cast for Candidate ");
                Serial.print(g_selectedCand);
                Serial.print(" | New Total = ");
                Serial.println(g_voteCounts[g_selectedCand - 1]);
                TransitionTo(STATE_VOTE_COMMITTED, "Vote confirmed -> STATE_VOTE_COMMITTED");
            } else if (key == 'C') {
                g_selectedCand = 0;
                TransitionTo(STATE_READY, "Selection cancelled by voter -> STATE_READY");
            } else if (key != '\0' || (btnEvent >= 0 && btnEvent <= 3)) {
                TransitionTo(STATE_ERROR, "Unconfirmed input in SELECTED state");
            }
            break;

        case STATE_VOTE_COMMITTED:
            if ((g_sysMillis - g_stateTimerStart) >= VOTE_FEEDBACK_MS) {
                g_selectedCand = 0;
                TransitionTo(STATE_READY, "Confirmation feedback complete -> STATE_READY");
            }
            break;

        case STATE_ADMIN_PIN_ENTRY:
            if (key >= '0' && key <= '9' && g_pinLen < 4) {
                g_pinBuffer[g_pinLen++] = key;
                g_uiDirty = true;
                if (g_pinLen == 4) {
                    if (strcmp(g_pinBuffer, ADMIN_PIN_CODE) == 0) {
                        TransitionTo(STATE_ADMIN_RESULTS, "Admin PIN verified -> STATE_ADMIN_RESULTS");
                    } else {
                        TransitionTo(STATE_ERROR, "Incorrect Admin PIN entered");
                    }
                }
            } else if (key == 'D') {
                TransitionTo(STATE_READY, "Admin login aborted -> STATE_READY");
            }
            break;

        case STATE_ADMIN_RESULTS:
            if (key == '#') {
                for (uint8_t i = 0; i < NUM_CANDIDATES; i++) g_voteCounts[i] = 0;
                g_uiDirty = true;
                UART_Log("ADMIN", "All candidate vote counters reset to 0");
            } else if (key == 'D') {
                TransitionTo(STATE_READY, "Exited Admin Results -> STATE_READY");
            }
            break;

        case STATE_ERROR:
            if ((g_sysMillis - g_stateTimerStart) >= ERROR_FEEDBACK_MS) {
                g_selectedCand = 0;
                TransitionTo(STATE_READY, "Error recovery -> STATE_READY");
            }
            break;

        default:
            TransitionTo(STATE_READY, "Fallback recovery");
            break;
    }

    // 3. Refresh Outputs (Non-blocking LEDs & Dirty-Flagged TFT)
    LED_UpdateOutputs();
    UI_RenderScreen();
}
